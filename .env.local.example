# Local development: `npx wrangler dev` and the scripts in scripts/site/.
# Optional: wrangler falls back to your `npx wrangler login` session when these are empty.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Cloudflare API token from the "Edit Cloudflare Workers" template, scoped to the tensorcode.dev zone
CLOUDFLARE_API_TOKEN=
