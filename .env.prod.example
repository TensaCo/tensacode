# Production deploys from your machine: `node scripts/site/build-docs.mjs && npx wrangler deploy`.
# Load with: set -a; . ./.env.prod; set +a
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Cloudflare API token from the "Edit Cloudflare Workers" template, scoped to the tensorcode.dev zone
CLOUDFLARE_API_TOKEN=
