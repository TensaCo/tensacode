# GitHub Actions secrets for TensaCo/tensacode (used by .github/workflows/deploy.yml).
# Upload with: gh secret set -f .env.gh -R TensaCo/tensacode
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Cloudflare API token from the "Edit Cloudflare Workers" template, scoped to the tensorcode.dev zone
CLOUDFLARE_API_TOKEN=
