// Cloudflare Workers static assets for https://tensorcode.dev (the TensorCode product site).
// Build the docs first:  node scripts/site/build-docs.mjs
// Preview:               npx wrangler dev
// Deploy:                node scripts/site/build-docs.mjs && npx wrangler deploy
{
  "name": "tensorcode-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
